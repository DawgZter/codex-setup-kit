# Copy only the variables you actually use into your own secret manager or
# shell environment. Never commit the populated file.

AGENTENRICH_API_KEY=
BLAND_API_KEY=
CONTEXT_DEV_API_KEY=
HEROUI_PERSONAL_TOKEN=
INSTANTLY_API_KEY=
LETSFG_API_KEY=
# Alternative to LETSFG_API_KEY when using a short-lived LetsFG login token:
LETSFG_BEARER_TOKEN=

# The LinkedIn automation endpoint is recipient-specific and may contain a
# credential. It is intentionally not included in the plugin's .mcp.json.
LINKEDIN_AUTOMATION_MCP_URL=

# Optional personalization for the Adapt Chrome selector skill.
CODEX_WORK_CHROME_EMAIL=
CODEX_PERSONAL_CHROME_EMAIL=
